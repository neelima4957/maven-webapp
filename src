pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    stages {

        stage('Git Checkout') {
            steps {
                git 'https://github.com/username/mywebapp.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deploy WAR') {
            steps {
                deploy adapters: [
                    tomcat9(
                        credentialsId: 'tomcat',
                        path: '',
                        url: 'http://<EC2-PUBLIC-IP>:9090/'
                    )
                ],
                contextPath: 'mywebapp',
                war: '**/*.war'
            }
        }
    }
}
